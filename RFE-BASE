<style>
:root{--bg:#09090b;--panel:#121215;--panel2:#18181d;--line:#29292f;--red:#e3262e;--red2:#a9151d;--text:#f5f5f6;--muted:#a2a2aa;--green:#40c98a;--yellow:#f2b84b;--radius:18px;--shadow:0 16px 45px #0008}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 80% -10%,#421115 0,transparent 35%),var(--bg);color:var(--text);font:15px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;min-height:100vh}button,input,select,textarea{font:inherit}button{cursor:pointer}.app{max-width:1220px;margin:auto;padding:20px 22px 48px}.top{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:10px 0 24px;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:13px}.mark{width:52px;height:44px;border:2px solid var(--red);display:grid;place-items:center;font-weight:1000;font-size:24px;letter-spacing:-3px;transform:skew(-9deg);box-shadow:4px 4px 0 #7c1018}.brand h1{margin:0;font-size:17px;letter-spacing:2px;font-weight:900}.brand small{display:block;color:#c5c5ca;font-size:10px;letter-spacing:3px;margin-top:2px}.top-right{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.pill{border:1px solid #5a2428;color:#ffb3b7;background:#301014;padding:7px 11px;border-radius:999px;font-size:11px;font-weight:800;letter-spacing:1px}.mode{display:flex;background:#17171b;border:1px solid var(--line);border-radius:12px;padding:4px}.mode button{border:0;color:var(--muted);background:transparent;padding:9px 13px;border-radius:9px;font-weight:800;font-size:12px}.mode button.active{background:var(--red);color:#fff}.hero{padding:25px 0 20px;display:flex;justify-content:space-between;align-items:end;gap:20px}.eyebrow{color:#ff696f;text-transform:uppercase;letter-spacing:3px;font-size:10px;font-weight:900}.hero h2{font-size:clamp(28px,4vw,43px);line-height:1.04;margin:7px 0 8px;font-weight:950;letter-spacing:-1.4px}.hero p{margin:0;color:var(--muted);max-width:580px}.hero-actions{display:flex;gap:9px;flex-wrap:wrap}.btn{border:1px solid var(--line);color:var(--text);background:#1a1a1f;padding:10px 14px;border-radius:11px;font-weight:800;font-size:12px;transition:.15s}.btn:hover{border-color:#777}.btn.primary{background:var(--red);border-color:var(--red);color:white}.btn.primary:hover{background:#f13942}.btn.ghostred{border-color:#68242a;color:#ff858a;background:#210d10}.btn.small{padding:7px 10px;font-size:11px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:12px 0 22px}.stat{background:linear-gradient(145deg,#17171b,#101013);border:1px solid var(--line);border-radius:15px;padding:15px 17px}.stat .label{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:1.3px;font-weight:800}.stat .num{font-size:29px;font-weight:950;margin-top:3px}.stat .hint{color:#73737c;font-size:11px}.layout{display:grid;grid-template-columns:270px minmax(0,1fr);gap:17px;align-items:start}.side,.content-card{background:#111114;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}.side{padding:16px;position:sticky;top:12px}.section-label{font-size:10px;letter-spacing:2px;color:#777780;text-transform:uppercase;font-weight:900;margin:3px 0 12px}.student-list{display:grid;gap:7px}.student-item{display:flex;align-items:center;gap:10px;padding:10px;border:1px solid transparent;border-radius:12px;background:transparent;color:var(--text);text-align:left;width:100%}.student-item:hover{background:#1a1a1f}.student-item.active{background:#2b1114;border-color:#76232a}.avatar{width:35px;height:35px;border-radius:11px;background:#29292f;color:#fff;display:grid;place-items:center;font-weight:900}.student-item.active .avatar{background:var(--red)}.student-meta{min-width:0}.student-meta b{display:block;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.student-meta small{color:var(--muted);font-size:10px}.content-card{padding:20px;min-height:450px}.content-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:17px}.content-head h3{margin:0;font-size:20px}.content-head p{margin:4px 0 0;color:var(--muted);font-size:12px}.tabbar{display:flex;gap:7px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding-bottom:13px;margin-bottom:18px}.tab{background:transparent;border:1px solid transparent;color:#9b9ba3;padding:8px 12px;border-radius:9px;font-size:11px;font-weight:800}.tab.active{color:white;background:#2d1114;border-color:#70232a}.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.field{display:grid;gap:6px;margin-bottom:12px}.field label{font-size:10px;color:#aaaab2;text-transform:uppercase;letter-spacing:1px;font-weight:900}.field input,.field select,.field textarea{width:100%;background:#09090c;color:var(--text);border:1px solid #34343c;border-radius:10px;padding:11px 12px;outline:none}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--red)}.field textarea{min-height:85px;resize:vertical}.exercise{border:1px solid var(--line);background:#17171b;border-radius:13px;padding:13px;margin:10px 0}.exercise-top{display:flex;justify-content:space-between;gap:10px;align-items:start}.exercise h4{margin:0;font-size:14px}.exercise small{color:var(--muted)}.chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px}.chip{background:#25252b;border:1px solid #37373e;color:#ddd;padding:4px 8px;border-radius:7px;font-size:10px;font-weight:800}.chip.red{background:#351216;border-color:#6f262c;color:#ff9ca1}.empty{border:1px dashed #42424a;border-radius:13px;padding:30px 18px;text-align:center;color:var(--muted)}.empty strong{display:block;color:#eee;margin-bottom:4px}.muted{color:var(--muted)}.student-view{display:grid;gap:14px}.workout-card{border:1px solid var(--line);border-radius:15px;background:linear-gradient(145deg,#19191e,#111114);padding:16px}.workout-card h4{margin:0 0 5px;font-size:16px}.workout-card p{margin:0;color:var(--muted);font-size:12px}.exercise-row{display:grid;grid-template-columns:1.5fr repeat(4,.65fr);gap:8px;align-items:center;padding:11px 0;border-bottom:1px solid #29292f}.exercise-row:last-child{border-bottom:0}.exercise-row strong{font-size:12px}.exercise-row span{font-size:11px;color:#b8b8c0}.exercise-row input{width:100%;min-width:0;background:#09090c;color:#fff;border:1px solid #3c3c44;border-radius:8px;padding:7px;font-size:12px}.tablehead{display:grid;grid-template-columns:1.5fr repeat(4,.65fr);gap:8px;color:#777780;font-size:9px;letter-spacing:1px;text-transform:uppercase;border-bottom:1px solid var(--line);padding:7px 0}.notice{border:1px solid #5c481d;background:#211b0e;color:#f4d18a;border-radius:11px;padding:11px 13px;font-size:11px;margin-top:14px}.success{color:var(--green)}.danger{color:#ff757b}.footer{display:flex;justify-content:space-between;color:#64646c;font-size:10px;margin-top:25px;letter-spacing:1px}.modal-backdrop{position:fixed;inset:0;background:#000b;display:none;align-items:center;justify-content:center;padding:18px;z-index:10}.modal-backdrop.show{display:flex}.modal{width:min(560px,100%);max-height:90vh;overflow:auto;background:#151519;border:1px solid #444;border-radius:18px;padding:21px;box-shadow:0 25px 90px #000}.modal h3{margin:0 0 16px}.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}.inline-actions{display:flex;gap:7px;flex-wrap:wrap}.hide{display:none!important}.mobile-label{display:none}
@media(max-width:820px){.app{padding:13px 13px 35px}.top{align-items:flex-start}.hero{align-items:flex-start;flex-direction:column}.stats{grid-template-columns:repeat(2,1fr)}.layout{grid-template-columns:1fr}.side{position:static}.student-list{display:flex;overflow:auto;padding-bottom:4px}.student-item{min-width:175px}.content-card{padding:15px}.grid2{grid-template-columns:1fr}.top-right{justify-content:flex-end}.exercise-row,.tablehead{grid-template-columns:1.2fr repeat(2,.65fr)}.exercise-row .optional,.tablehead .optional{display:none}.footer{gap:8px;flex-direction:column}}
@media(max-width:480px){.brand h1{font-size:14px}.mark{width:45px;height:40px}.pill{display:none}.mode button{padding:8px 9px}.hero h2{font-size:31px}.stats{gap:8px}.stat{padding:12px}.stat .num{font-size:24px}.content-head{align-items:flex-start;flex-direction:column}.exercise-row,.tablehead{grid-template-columns:1.2fr .7fr .7fr}.exercise-row .extra,.tablehead .extra{display:none}}
</style></head>
<body><div class="app">
<header class="top"><div class="brand"><div class="mark">RFE</div><div><h1>RUIZ FIGHT EVOLUTION</h1><small>TRAINING SYSTEM</small></div></div><div class="top-right"><span class="pill">FIGHT AND DESTROY</span><div class="mode"><button id="trainerMode" class="active">TREINADOR</button><button id="studentMode">ALUNO</button></div></div></header>
<section class="hero"><div><div class="eyebrow">Plataforma de treinamento</div><h2 id="heroTitle">Comando da sua evolução.</h2><p id="heroDesc">Gerencie alunos, prescreva sessões e acompanhe cada etapa do treinamento.</p></div><div class="hero-actions" id="heroActions"><button class="btn primary" id="addStudentBtn">＋ Adicionar aluno</button><button class="btn" id="exportBtn">↓ Exportar backup</button><button class="btn" id="importBtn">↑ Importar backup</button></div></section>
<div class="stats" id="stats"><div class="stat"><div class="label">Alunos cadastrados</div><div class="num" id="statStudents">0</div><div class="hint">Base RFE</div></div><div class="stat"><div class="label">Programas ativos</div><div class="num" id="statPrograms">0</div><div class="hint">Treinos prescritos</div></div><div class="stat"><div class="label">Sessões concluídas</div><div class="num" id="statDone">0</div><div class="hint">Registros dos alunos</div></div><div class="stat"><div class="label">Exercícios cadastrados</div><div class="num" id="statExercises">0</div><div class="hint">Na biblioteca de treinos</div></div></div>
<div class="layout" id="trainerLayout"><aside class="side"><div class="section-label">Carteira de alunos</div><div id="studentList" class="student-list"></div><button class="btn ghostred" style="width:100%;margin-top:12px" id="addStudentSide">＋ Novo aluno</button><div class="notice">Os dados desta versão ficam salvos neste navegador. Faça backups regularmente.</div></aside><main class="content-card"><div id="trainerContent"></div></main></div>
<div class="content-card student-view hide" id="studentLayout"></div>
<div class="footer"><span>RFE • RUIZ FIGHT EVOLUTION</span><span>STRENGTH · PERFORMANCE · LONGEVITY</span></div>
</div>
<div class="modal-backdrop" id="modalBackdrop"><div class="modal" id="modal"></div></div><input type="file" id="importFile" accept="application/json,.json" class="hide">
<script>
(()=>{
const KEY='rfe_training_system_v1';
const $=id=>document.getElementById(id);
const uid=()=>Math.random().toString(36).slice(2,9);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const demo=()=>({students:[{id:'demo01',name:'Aluno demonstração',email:'',goal:'Força e condicionamento',level:'Intermediário',created:new Date().toISOString(),programs:[{id:'prog01',name:'Programa RFE — Base',duration:'6 semanas',notes:'Exemplo editável. Ajuste o volume e a intensidade de acordo com a avaliação individual.',sessions:[{id:'sessA',name:'Sessão A — Força',day:'Segunda-feira',notes:'Priorize técnica e controle de movimento.',exercises:[{id:uid(),name:'Agachamento',sets:'4',reps:'6–8',load:'',rpe:'7',rest:'120 s',notes:'Amplitude confortável.'},{id:uid(),name:'Supino reto',sets:'3',reps:'8–10',load:'',rpe:'7',rest:'90 s',notes:''},{id:uid(),name:'Remada baixa',sets:'3',reps:'10–12',load:'',rpe:'7',rest:'90 s',notes:''}]},{id:'sessB',name:'Sessão B — Posterior e core',day:'Quinta-feira',notes:'Exemplo de sessão complementar.',exercises:[{id:uid(),name:'Terra romeno',sets:'3',reps:'8',load:'',rpe:'7',rest:'120 s',notes:''},{id:uid(),name:'Mesa flexora',sets:'3',reps:'10–12',load:'',rpe:'7',rest:'60 s',notes:''},{id:uid(),name:'Prancha',sets:'3',reps:'30–45 s',load:'',rpe:'6',rest:'45 s',notes:''}]}]}],logs:[]} ]});
let db=load(), selected=db.students[0]?.id||null, mode='trainer',tab='overview',selectedProgram=null,selectedSession=null;
function load(){try{const x=JSON.parse(localStorage.getItem(KEY));return x&&Array.isArray(x.students)?x:demo()}catch{return demo()}}
function save(){localStorage.setItem(KEY,JSON.stringify(db));render()}
function student(){return db.students.find(s=>s.id===selected)}
function activeProgram(s=student()){return s?.programs?.find(p=>p.id===selectedProgram)||s?.programs?.[0]}
function allExercises(){return db.students.reduce((n,s)=>n+(s.programs||[]).reduce((m,p)=>m+(p.sessions||[]).reduce((k,se)=>k+(se.exercises||[]).length,0),0),0)}
function render(){
$('trainerMode').classList.toggle('active',mode==='trainer');$('studentMode').classList.toggle('active',mode==='student');
$('trainerLayout').classList.toggle('hide',mode!=='trainer');$('studentLayout').classList.toggle('hide',mode!=='student');$('stats').classList.toggle('hide',mode!=='trainer');$('heroActions').classList.toggle('hide',mode!=='trainer');
$('heroTitle').textContent=mode==='trainer'?'Comando da sua evolução.':'Seu treino. Sua evolução.';$('heroDesc').textContent=mode==='trainer'?'Gerencie alunos, prescreva sessões e acompanhe cada etapa do treinamento.':'Consulte suas sessões, registre cargas e acompanhe seu histórico.';
$('statStudents').textContent=db.students.length;$('statPrograms').textContent=db.students.reduce((n,s)=>n+(s.programs||[]).length,0);$('statDone').textContent=db.students.reduce((n,s)=>n+(s.logs||[]).length,0);$('statExercises').textContent=allExercises();
renderStudentList();mode==='trainer'?renderTrainer():renderStudent();
}
function renderStudentList(){const list=$('studentList');if(!db.students.length){list.innerHTML='<div class="empty"><strong>Nenhum aluno cadastrado</strong>Adicione seu primeiro aluno.</div>';return}list.innerHTML=db.students.map(s=>`<button class="student-item ${s.id===selected?'active':''}" data-student="${s.id}"><span class="avatar">${esc((s.name||'?').split(' ').map(x=>x[0]).slice(0,2).join('').toUpperCase())}</span><span class="student-meta"><b>${esc(s.name)}</b><small>${esc(s.goal||'Objetivo não definido')}</small></span></button>`).join('');list.querySelectorAll('[data-student]').forEach(b=>b.onclick=()=>{selected=b.dataset.student;selectedProgram=null;tab='overview';render()})}
function renderTrainer(){const root=$('trainerContent'),s=student();if(!s){root.innerHTML='<div class="empty"><strong>Comece cadastrando um aluno</strong>Depois, monte o primeiro programa de treinamento.</div>';return}
const p=activeProgram(s);if(p)selectedProgram=p.id;
root.innerHTML=`<div class="content-head"><div><div class="eyebrow">Ficha do aluno</div><h3>${esc(s.name)}</h3><p>${esc(s.goal||'Objetivo não definido')} · ${esc(s.level||'Nível não definido')}</p></div><div class="inline-actions"><button class="btn small" id="editStudent">Editar cadastro</button><button class="btn small" id="deleteStudent">Excluir</button></div></div>
<div class="tabbar"><button class="tab ${tab==='overview'?'active':''}" data-tab="overview">VISÃO GERAL</button><button class="tab ${tab==='program'?'active':''}" data-tab="program">PROGRAMAS E TREINOS</button><button class="tab ${tab==='history'?'active':''}" data-tab="history">HISTÓRICO</button></div><div id="tabBody"></div>`;
root.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>{tab=b.dataset.tab;renderTrainer()});$('editStudent').onclick=()=>studentModal(s);$('deleteStudent').onclick=()=>deleteStudent(s);const body=$('tabBody');
if(tab==='overview')body.innerHTML=`<div class="grid2"><div class="stat"><div class="label">Programas deste aluno</div><div class="num">${s.programs.length}</div><div class="hint">Planos de treinamento</div></div><div class="stat"><div class="label">Sessões realizadas</div><div class="num">${s.logs.length}</div><div class="hint">Histórico registrado</div></div></div><div style="margin-top:18px"><div class="content-head"><div><h3>Programas cadastrados</h3><p>Organize os ciclos e sessões do aluno.</p></div><button class="btn primary" id="newProgram">＋ Criar programa</button></div>${s.programs.length?s.programs.map(pr=>`<div class="exercise"><div class="exercise-top"><div><h4>${esc(pr.name)}</h4><small>${esc(pr.duration||'Duração não definida')} · ${(pr.sessions||[]).length} sessões</small></div><button class="btn small" data-open-program="${pr.id}">Abrir programa →</button></div></div>`).join(''):'<div class="empty"><strong>Nenhum programa ainda</strong>Crie o primeiro programa deste aluno.</div>'}</div>`;
if(tab==='program')body.innerHTML=renderProgramEditor(s,p);
if(tab==='history')body.innerHTML=renderHistory(s);
if($('newProgram'))$('newProgram').onclick=()=>programModal();body.querySelectorAll('[data-open-program]').forEach(b=>{selectedProgram=b.dataset.openProgram;tab='program';renderTrainer()});wireProgramEditor();
}
function renderProgramEditor(s,p){if(!p)return `<div class="empty"><strong>Nenhum programa cadastrado</strong><button class="btn primary" id="createFirstProgram">Criar programa</button></div>`;
const se=p.sessions||[];const current=se.find(x=>x.id===selectedSession)||se[0];if(current)selectedSession=current.id;
return `<div class="content-head"><div><h3>${esc(p.name)}</h3><p>${esc(p.duration||'')} · ${se.length} sessões cadastradas</p></div><div class="inline-actions"><button class="btn small" id="editProgram">Editar</button><button class="btn small" id="addSession">＋ Sessão</button></div></div>${p.notes?`<p class="muted" style="font-size:12px">${esc(p.notes)}</p>`:''}<div class="tabbar">${se.map(x=>`<button class="tab ${current?.id===x.id?'active':''}" data-session="${x.id}">${esc(x.name)}</button>`).join('')}<button class="tab" id="addSessionTab">＋ ADICIONAR</button></div>${current?`<div class="content-head"><div><h3>${esc(current.name)}</h3><p>${esc(current.day||'')} ${current.notes?'· '+esc(current.notes):''}</p></div><div class="inline-actions"><button class="btn small" id="editSession">Editar sessão</button><button class="btn primary small" id="addExercise">＋ Exercício</button></div></div>${(current.exercises||[]).length?current.exercises.map(e=>`<div class="exercise"><div class="exercise-top"><div><h4>${esc(e.name)}</h4><small>${esc(e.notes||'Sem observações')}</small></div><div class="inline-actions"><button class="btn small" data-edit-ex="${e.id}">Editar</button><button class="btn small danger" data-del-ex="${e.id}">Excluir</button></div></div><div class="chips"><span class="chip">${esc(e.sets)} séries</span><span class="chip">${esc(e.reps)} reps</span><span class="chip red">RPE ${esc(e.rpe||'—')}</span><span class="chip">Carga: ${esc(e.load||'a definir')}</span><span class="chip">Descanso: ${esc(e.rest||'—')}</span></div></div>`).join(''):'<div class="empty"><strong>Esta sessão está vazia</strong>Adicione o primeiro exercício.</div>'}`:'<div class="empty"><strong>Este programa ainda não tem sessões</strong>Adicione uma sessão para começar.</div>'}<div class="inline-actions" style="margin-top:17px"><button class="btn" id="duplicateProgram">Duplicar programa</button><button class="btn danger" id="deleteProgram">Excluir programa</button></div>`}
function wireProgramEditor(){const p=activeProgram();if($('createFirstProgram'))$('createFirstProgram').onclick=()=>programModal();if(!p)return;if($('editProgram'))$('editProgram').onclick=()=>programModal(p);if($('addSession'))$('addSession').onclick=()=>sessionModal();if($('addSessionTab'))$('addSessionTab').onclick=()=>sessionModal();if($('editSession'))$('editSession').onclick=()=>sessionModal((p.sessions||[]).find(x=>x.id===selectedSession));if($('addExercise'))$('addExercise').onclick=()=>exerciseModal();$('tabBody').querySelectorAll('[data-session]').forEach(b=>b.onclick=()=>{selectedSession=b.dataset.session;renderTrainer()});$('tabBody').querySelectorAll('[data-edit-ex]').forEach(b=>b.onclick=()=>exerciseModal((p.sessions.find(x=>x.id===selectedSession).exercises||[]).find(e=>e.id===b.dataset.editEx)));$('tabBody').querySelectorAll('[data-del-ex]').forEach(b=>b.onclick=()=>{const se=p.sessions.find(x=>x.id===selectedSession);se.exercises=se.exercises.filter(e=>e.id!==b.dataset.delEx);save()});if($('deleteProgram'))$('deleteProgram').onclick=()=>{if(confirm('Excluir este programa e suas sessões?')){student().programs=student().programs.filter(x=>x.id!==p.id);selectedProgram=null;save()}};if($('duplicateProgram'))$('duplicateProgram').onclick=()=>{const cp=JSON.parse(JSON.stringify(p));cp.id=uid();cp.name+=' (cópia)';cp.sessions.forEach(se=>{se.id=uid();se.exercises.forEach(e=>e.id=uid())});student().programs.push(cp);selectedProgram=cp.id;save()}}
function renderHistory(s){if(!s.logs.length)return '<div class="empty"><strong>Nenhum treino concluído ainda</strong>Os registros feitos pelo aluno aparecerão aqui.</div>';return [...s.logs].reverse().map(l=>`<div class="exercise"><div class="exercise-top"><div><h4>${esc(l.sessionName)}</h4><small>${new Date(l.date).toLocaleString('pt-BR')}</small></div><span class="chip red">Concluído</span></div>${(l.entries||[]).map(e=>`<div class="chips"><span class="chip">${esc(e.exercise)}</span><span class="chip">Carga: ${esc(e.load||'—')}</span><span class="chip">RPE: ${esc(e.rpe||'—')}</span></div>`).join('')}</div>`).join('')}
function renderStudent(){const root=$('studentLayout');if(!db.students.length){root.innerHTML='<div class="empty"><strong>Nenhum aluno disponível</strong>Cadastre um aluno no modo treinador para testar.</div>';return}root.innerHTML=`<div class="content-head"><div><div class="eyebrow">Área do aluno · demonstração</div><h3>Olá, ${esc(student()?.name||'atleta')}.</h3><p>Selecione seu perfil e consulte o programa prescrito.</p></div><div class="field" style="min-width:210px;margin:0"><label>Perfil de aluno</label><select id="studentSelect">${db.students.map(s=>`<option value="${s.id}" ${s.id===selected?'selected':''}>${esc(s.name)}</option>`).join('')}</select></div></div>${studentWorkout()}`;$('studentSelect').onchange=e=>{selected=e.target.value;renderStudent()};root.querySelectorAll('[data-start-session]').forEach(b=>b.onclick=()=>startSession(b.dataset.startSession));root.querySelectorAll('[data-complete-session]').forEach(b=>b.onclick=()=>completeSession(b.dataset.completeSession));}
function studentWorkout(){const s=student(),p=activeProgram(s);if(!s||!p)return '<div class="empty"><strong>Nenhum treino prescrito</strong>Seu treinador ainda não cadastrou um programa.</div>';return `<div class="workout-card"><div class="eyebrow">Programa atual</div><h4>${esc(p.name)}</h4><p>${esc(p.duration||'')} ${p.notes?'· '+esc(p.notes):''}</p></div>${(p.sessions||[]).map(se=>`<div class="workout-card"><div class="content-head"><div><div class="eyebrow">${esc(se.day||'Sessão')}</div><h4>${esc(se.name)}</h4><p>${esc(se.notes||'Execute conforme as orientações do treinador.')}</p></div><button class="btn primary small" data-start-session="${se.id}">Iniciar treino</button></div>${(se.exercises||[]).map(e=>`<div class="exercise-row"><strong>${esc(e.name)}<small style="display:block;color:#777">${esc(e.notes||'')}</small></strong><span>${esc(e.sets)} × ${esc(e.reps)}</span><span>RPE ${esc(e.rpe||'—')}</span><span class="optional">${esc(e.rest||'')}</span><span class="optional">${esc(e.load||'Livre')}</span></div>`).join('')||'<p class="muted">Sem exercícios nesta sessão.</p>'}</div>`).join('')||'<div class="empty">Nenhuma sessão cadastrada.</div>'}<div class="workout-card"><h4>Meu histórico</h4><p>${s.logs.length} sessões registradas.</p>${s.logs.slice(-3).reverse().map(l=>`<div class="chips"><span class="chip">${new Date(l.date).toLocaleDateString('pt-BR')}</span><span class="chip red">${esc(l.sessionName)}</span></div>`).join('')}</div>`}
function startSession(id){const s=student(),p=activeProgram(s),se=p.sessions.find(x=>x.id===id);if(!se)return;openModal(`<div class="eyebrow">Registro de treino</div><h3>${esc(se.name)}</h3><p class="muted">Registre as cargas utilizadas e o RPE percebido.</p><form id="logForm">${se.exercises.map(e=>`<div class="exercise"><b>${esc(e.name)}</b><div class="grid2" style="margin-top:8px"><div class="field"><label>Carga utilizada</label><input name="load_${e.id}" placeholder="Ex.: 40 kg"></div><div class="field"><label>RPE realizado</label><input name="rpe_${e.id}" placeholder="Ex.: 8" inputmode="decimal"></div></div></div>`).join('')}<div class="field"><label>Observações do treino</label><textarea name="notes" placeholder="Como foi a sessão? Algum desconforto ou dificuldade?"></textarea></div><div class="modal-actions"><button type="button" class="btn" id="cancelModal">Cancelar</button><button class="btn primary" type="submit">Salvar treino concluído</button></div></form>`);$('cancelModal').onclick=closeModal;$('logForm').onsubmit=e=>{e.preventDefault();const fd=new FormData(e.target);s.logs.push({id:uid(),date:new Date().toISOString(),sessionName:se.name,entries:se.exercises.map(ex=>({exercise:ex.name,load:fd.get('load_'+ex.id)||'',rpe:fd.get('rpe_'+ex.id)||''})),notes:fd.get('notes')||''});closeModal();save()}}
function openModal(html){$('modal').innerHTML=html;$('modalBackdrop').classList.add('show')};function closeModal(){$('modalBackdrop').classList.remove('show')};$('modalBackdrop').addEventListener('click',e=>{if(e.target===$('modalBackdrop'))closeModal()});
function studentModal(s){openModal(`<h3>${s?'Editar aluno':'Adicionar aluno'}</h3><form id="studentForm"><div class="field"><label>Nome completo *</label><input name="name" required value="${esc(s?.name||'')}" placeholder="Nome do aluno"></div><div class="grid2"><div class="field"><label>E-mail (opcional)</label><input name="email" type="email" value="${esc(s?.email||'')}"></div><div class="field"><label>Nível</label><select name="level"><option ${s?.level==='Iniciante'?'selected':''}>Iniciante</option><option ${s?.level==='Intermediário'?'selected':''}>Intermediário</option><option ${s?.level==='Avançado'?'selected':''}>Avançado</option></select></div></div><div class="field"><label>Objetivo principal</label><input name="goal" value="${esc(s?.goal||'')}" placeholder="Ex.: força, hipertrofia, condicionamento"></div><div class="modal-actions"><button type="button" class="btn" id="cancelModal">Cancelar</button><button class="btn primary">Salvar aluno</button></div></form>`);$('cancelModal').onclick=closeModal;$('studentForm').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target);if(s){Object.assign(s,{name:f.get('name'),email:f.get('email'),level:f.get('level'),goal:f.get('goal')})}else{const n={id:uid(),name:f.get('name'),email:f.get('email'),level:f.get('level'),goal:f.get('goal'),created:new Date().toISOString(),programs:[],logs:[]};db.students.push(n);selected=n.id}closeModal();tab='overview';save()}}
function deleteStudent(s){if(!confirm(`Excluir ${s.name} e todos os seus dados?`))return;db.students=db.students.filter(x=>x.id!==s.id);selected=db.students[0]?.id||null;tab='overview';save()}
function programModal(p){openModal(`<h3>${p?'Editar programa':'Novo programa'}</h3><form id="programForm"><div class="field"><label>Nome do programa *</label><input required name="name" value="${esc(p?.name||'')}" placeholder="Ex.: RFE Strength & Hypertrophy"></div><div class="field"><label>Duração</label><input name="duration" value="${esc(p?.duration||'')}" placeholder="Ex.: 6 semanas"></div><div class="field"><label>Orientações gerais</label><textarea name="notes">${esc(p?.notes||'')}</textarea></div><div class="modal-actions"><button type="button" class="btn" id="cancelModal">Cancelar</button><button class="btn primary">Salvar programa</button></div></form>`);$('cancelModal').onclick=closeModal;$('programForm').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target);if(p)Object.assign(p,{name:f.get('name'),duration:f.get('duration'),notes:f.get('notes')});else{const n={id:uid(),name:f.get('name'),duration:f.get('duration'),notes:f.get('notes'),sessions:[]};student().programs.push(n);selectedProgram=n.id}closeModal();tab='program';save()}}
function sessionModal(se){openModal(`<h3>${se?'Editar sessão':'Adicionar sessão'}</h3><form id="sessionForm"><div class="field"><label>Nome da sessão *</label><input name="name" required value="${esc(se?.name||'')}" placeholder="Ex.: Sessão A — Força"></div><div class="field"><label>Dia ou organização</label><input name="day" value="${esc(se?.day||'')}" placeholder="Ex.: Segunda-feira"></div><div class="field"><label>Orientações</label><textarea name="notes">${esc(se?.notes||'')}</textarea></div><div class="modal-actions"><button type="button" class="btn" id="cancelModal">Cancelar</button><button class="btn primary">Salvar sessão</button></div></form>`);$('cancelModal').onclick=closeModal;$('sessionForm').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target),p=activeProgram();if(se)Object.assign(se,{name:f.get('name'),day:f.get('day'),notes:f.get('notes')});else{const n={id:uid(),name:f.get('name'),day:f.get('day'),notes:f.get('notes'),exercises:[]};p.sessions.push(n);selectedSession=n.id}closeModal();save()}}
function exerciseModal(ex){const p=activeProgram(),se=p.sessions.find(x=>x.id===selectedSession);openModal(`<h3>${ex?'Editar exercício':'Adicionar exercício'}</h3><form id="exerciseForm"><div class="field"><label>Nome do exercício *</label><input name="name" required value="${esc(ex?.name||'')}" placeholder="Ex.: Agachamento livre"></div><div class="grid2"><div class="field"><label>Séries</label><input name="sets" value="${esc(ex?.sets||'3')}" placeholder="3"></div><div class="field"><label>Repetições / tempo</label><input name="reps" value="${esc(ex?.reps||'8–10')}" placeholder="8–10"></div><div class="field"><label>Carga sugerida</label><input name="load" value="${esc(ex?.load||'')}" placeholder="Ex.: 40 kg ou livre"></div><div class="field"><label>RPE alvo</label><input name="rpe" value="${esc(ex?.rpe||'7')}" placeholder="7"></div><div class="field"><label>Descanso</label><input name="rest" value="${esc(ex?.rest||'90 s')}" placeholder="90 s"></div></div><div class="field"><label>Observações / execução</label><textarea name="notes">${esc(ex?.notes||'')}</textarea></div><div class="modal-actions"><button type="button" class="btn" id="cancelModal">Cancelar</button><button class="btn primary">Salvar exercício</button></div></form>`);$('cancelModal').onclick=closeModal;$('exerciseForm').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target),v={name:f.get('name'),sets:f.get('sets'),reps:f.get('reps'),load:f.get('load'),rpe:f.get('rpe'),rest:f.get('rest'),notes:f.get('notes')};if(ex)Object.assign(ex,v);else se.exercises.push({id:uid(),...v});closeModal();save()}}
$('addStudentBtn').onclick=()=>studentModal();$('addStudentSide').onclick=()=>studentModal();$('exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify(db,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='rfe-backup-'+new Date().toISOString().slice(0,10)+'.json';a.click();URL.revokeObjectURL(a.href)};$('importBtn').onclick=()=>$('importFile').click();$('importFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{const x=JSON.parse(await f.text());if(!Array.isArray(x.students))throw Error();db=x;selected=db.students[0]?.id||null;save();alert('Backup importado com sucesso.')}catch{alert('Não foi possível importar. Confira se o arquivo é um backup RFE válido.')}e.target.value=''};$('trainerMode').onclick=()=>{mode='trainer';render()};$('studentMode').onclick=()=>{mode='student';render()};
if('serviceWorker'in navigator && location.protocol.startsWith('http'))window.addEventListener('load',()=>navigator.serviceWorker.register('./sw.js').catch(()=>{}));
render();
})();
